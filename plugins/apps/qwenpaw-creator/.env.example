# ============================================================
# QwenPaw Creator plugin fallback configuration
# ============================================================
#
# Preferred runtime configuration is through QwenPaw agent tool settings:
# - creator_text_model
# - creator_image_model
# - creator_video_model
# - creator_asr_model
# - creator_media_oss
#
# These environment variables remain as a local/dev fallback.

# Native runtime tools. Creator never downloads executables by default.
# Configure absolute paths, install tools on PATH, or explicitly opt in to the
# pinned SHA-256-verified jq download.
CREATOR_AUTO_INSTALL_BINARIES=0
#CREATOR_JQ_PATH=/absolute/path/to/jq
#CREATOR_FFMPEG_PATH=/absolute/path/to/ffmpeg
#CREATOR_FFPROBE_PATH=/absolute/path/to/ffprobe
#CREATOR_BINARY_DIR=/absolute/path/to/creator-runtime-tools
#CREATOR_JQ_BASE_URL=https://approved-mirror.example/jq

# Text model (DashScope / AgentScope 2.0)
TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_API_KEY=your_dashscope_api_key
TEXT_MODEL_NAME=qwen3.7-plus
TEXT_CONCURRENCY=20

# Text model (DashScope / AgentScope 2.0)
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=your_dashscope_api_key
VLM_MODEL_NAME=qwen3.7-plus

# Speech recognition (fun-asr | whisper). ASR_API_KEY may be empty for
# Fun-ASR when the saved Creator configuration enables LLM key reuse.
ASR_ENABLED=false
ASR_PROVIDER=fun-asr
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_API_KEY=
ASR_MODEL_NAME=fun-asr
ASR_LANGUAGE=
ASR_TIMEOUT_SECONDS=1800

# Remote video download limits (for AI editing of large uploaded clips)
CREATOR_DOWNLOAD_MAX_BYTES=2147483648  # 2 GiB
CREATOR_DOWNLOAD_TIMEOUT_SECONDS=300

# which model is chosen
# DASHSCOPE | OPENAI
IMAGE_MODEL=DASHSCOPE
# Image generation model (OpenAI Images API format, via routify)
OPENAI_IMAGE_BASE_URL=https://routify.alibaba-inc.com/protocol/openai
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL_NAME=gpt-image-2
OPENAI_IMAGE_CONCURRENCY=1
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_TIMEOUT=120

# dashscope (qwen-image-2.0-pro, sync multimodal-generation)
# Keys are normally managed by the frontend key-management UI and persisted to
# the dedicated model config file (not .env). These env vars are only a
# standalone/local fallback.
DASHSCOPE_IMAGE_BASE_URL=https://{workspace-id}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_MODEL_NAME=qwen-image-2.0-pro
DASHSCOPE_IMAGE_CONCURRENCY=1
DASHSCOPE_IMAGE_QUALITY=low
DASHSCOPE_IMAGE_TIMEOUT=120

# Plugin UI build-time batch setting
VITE_IMAGE_CONCURRENCY=20

# Video generation model (Volcengine Seedance 2 format, via routify)
VIDEO_BASE_URL=https://routify.alibaba-inc.com/protocol/volcengine
VIDEO_API_KEY=
VIDEO_MODEL_NAME=doubao-seedance-2-0-260128
VIDEO_CONCURRENCY=1
VIDEO_SUBMIT_TIMEOUT=180
VIDEO_STATUS_TIMEOUT=30

# To use WAN instead of Seedance, replace the video settings above with:
# VIDEO_BASE_URL=https://{workspace-id}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
# VIDEO_API_KEY=your_dashscope_api_key
# VIDEO_MODEL_NAME=wan2.7-r2v
# Bailian HappyHorse reference-to-video is also supported on the same
# DashScope endpoint (1-9 image references, [Image N] prompt citations):
# VIDEO_MODEL_NAME=happyhorse-1.1-r2v

# Optional OSS settings for creator-store uploads
OSS_POLICY_API_KEY=
OSS_BUCKET=creator-store
OSS_PUBLIC_BASE_URL=
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Use this to overwrite app'd default INFO logging level
#CREATOR_LOGGING_LEVEL=DEBUG|INFO|WARNING|ERROR

# Tavily API key for web grounding (text and image)
#TAVILY_API_KEY=tvly-dev-XXX
