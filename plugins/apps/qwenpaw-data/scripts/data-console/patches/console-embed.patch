+        <>
+          <Button type="primary" href={SKILLS_REPO_URL} target="_blank" rel="noopener noreferrer">
+            {zh ? '浏览技能目录' : 'Browse the skills catalog'}
+          </Button>
+          <Button href={SKILLS_PACKAGE_URL} target="_blank" rel="noopener noreferrer">
+            {zh ? '贡献指南' : 'Contribution guide'}
+          </Button>
+          <Typography.Paragraph type="secondary" style={{ marginTop: 16 }}>
+            {zh
+              ? '本地技能位于 workspace/skills 目录，可直接编辑调试。'
