+
+/**
+ * DataBridge (Context service) infrastructure settings, served by the
+ * hosting app's backend rather than the engine API. The analysis agent's
+ * model lives in Agent Configuration; this page covers the semantic
+ * service's own model, the embedding model, and the Neo4j graph store.
+ */
+
+const CONFIG_BASE = '/api/qwenpaw-data';
+
+interface LlmConfig {
+  provider: string;
+  base_url: string;
+  model: string;
+  api_key: string;
+  reuse_host: boolean;
+  host_provider_name: string;
+}
+
+interface EmbeddingConfig {
+  base_url: string;
+  model: string;
+  dim: number;
+  api_key: string;
+  reuse_host: boolean;
+  host_provider_name: string;
+}
+
+interface Neo4jConfig {
+  uri: string;
+  user: string;
+  password: string;
+  database: string;
+}
+
+interface DataBridgeConfig {
+  version: number;
+  llm: LlmConfig;
+  embedding: EmbeddingConfig;
+  neo4j: Neo4jConfig;
+  datasources: { active_id: string };
+}
+
+interface TestResult {
+  ok: boolean;
+  error?: string;
+  detected_dim?: number | null;
+}
+
+const LLM_PRESETS: Array<{ value: string; label: string; baseUrl: string }> = [
+  { value: 'dashscope', label: 'DashScope (Aliyun)', baseUrl: 'https://dashscope.aliyuncs.com/compatible-mode/v1' },
+  { value: 'openai', label: 'OpenAI', baseUrl: 'https://api.openai.com/v1' },
+  { value: 'deepseek', label: 'DeepSeek', baseUrl: 'https://api.deepseek.com' },
+  { value: 'moonshot', label: 'Moonshot', baseUrl: 'https://api.moonshot.cn/v1' },
+  { value: 'siliconflow', label: 'SiliconFlow', baseUrl: 'https://api.siliconflow.cn/v1' },
+  { value: 'custom', label: 'Custom (OpenAI-compatible)', baseUrl: '' },
+];
+
+const STRINGS = {
+  zh: {
+    title: '数据底座配置',
+    description: 'DataBridge 语义服务的模型与存储；分析智能体的模型请在「智能体配置」中设置。',
+    llmTitle: '语义服务模型',
+    llmDescription: '用于语义织网、文档摄取等 DataBridge 内部任务（OpenAI 兼容协议）。分析对话使用的模型在「智能体配置」中单独设置。',
+    embeddingTitle: 'Embedding 模型',
+    embeddingDescription: '用于语义索引与检索的向量模型。',
+    neo4jTitle: 'Neo4j 图存储',
+    neo4jDescription: '保存语义知识图谱的图数据库。',
+    reuseHostLlm: '复用 QwenPaw 已配置的模型',
+    reuseHostEmbedding: '复用 QwenPaw 的 API 凭证',
+    provider: '服务商预设',
+    baseUrl: 'Base URL',
+    model: '模型',
+    apiKey: 'API key',
+    dimensions: 'Embedding 维度',
+    uri: 'URI',
+    user: '用户名',
+    password: '密码',
+    database: '数据库（可选）',
