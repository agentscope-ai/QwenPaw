+import { GithubOutlined } from '@ant-design/icons';
+import { Button, Result, Typography } from 'antd';
+import { useAppI18n } from '@/i18n';
+
+const SKILLS_REPO_URL =
+  'https://github.com/agentscope-ai/QwenPaw-Data/tree/main/skills';
+const SKILLS_PACKAGE_URL =
+  'https://github.com/agentscope-ai/QwenPaw-Data/tree/main/packages/qwenpaw-data-skills';
+
+export default function SkillsContribution() {
+  const { language } = useAppI18n();
+  const zh = language === 'zh';
+
+  return (
+    <Result
+      icon={<GithubOutlined />}
+      title={zh ? '技能中心' : 'Skills Hub'}
+      subTitle={
+        zh
+          ? '技能通过开源仓库共建：提交 PR 即可新增或改进分析方法论，安装后即刻生效。'
+          : 'Skills are built in the open-source repository: open a PR to add or improve an analysis methodology, and it ships with the next install.'
+      }
+      extra={
+        <>
+          <Button type="primary" href={SKILLS_REPO_URL} target="_blank" rel="noopener noreferrer">
+            {zh ? '浏览技能目录' : 'Browse the skills catalog'}
+          </Button>
+          <Button href={SKILLS_PACKAGE_URL} target="_blank" rel="noopener noreferrer">
+            {zh ? '贡献指南' : 'Contribution guide'}
+          </Button>
+          <Typography.Paragraph type="secondary" style={{ marginTop: 16 }}>
+            {zh
+              ? '本地技能位于 workspace/skills 目录，可直接编辑调试。'
+              : 'Local skills live under workspace/skills and can be edited in place for debugging.'}
+          </Typography.Paragraph>
+        </>
+      }
+    />
+  );
+}
