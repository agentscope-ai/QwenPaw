+        {loading ? <Spin /> : null}
+        {!loading && loadError ? (
+          <Alert
+            showIcon
+            type="error"
+            message={s.loadFailed}
+            description={loadError}
+            action={<Button size="small" onClick={() => void load()}>{s.retry}</Button>}
+          />
+        ) : null}
+        {!loading && !loadError && config ? (
+          <div style={{ display: 'grid', gap: 18, maxWidth: 1240 }}>
+            <div
+              style={{
+                display: 'grid',
+                gap: 18,
+                gridTemplateColumns: 'repeat(auto-fit, minmax(380px, 1fr))',
+              }}
+            >
+              <section className="datapaw-card-primary" style={cardStyle}>
+                <div style={cardHeadStyle}>
+                  <h2 style={{ margin: 0, fontSize: 16 }}>{s.llmTitle}</h2>
+                  <span style={{ color: 'var(--datapaw-color-text-tertiary, #86909c)', fontSize: 13 }}>
+                    {s.llmDescription}
+                  </span>
+                </div>
+                <Checkbox
+                  checked={config.llm.reuse_host}
