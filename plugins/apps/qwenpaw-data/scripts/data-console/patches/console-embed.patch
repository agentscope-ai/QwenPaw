+        {roles.map(role => {
+          const choice = draft[role.id]; const effective = data.effective[role.id];
+          const changed = JSON.stringify(choice) !== JSON.stringify(data.settings[role.id]);
+          const inheritedAnalysis = role.id !== 'analysis' && choice.source === 'inherit' && JSON.stringify(draft.analysis) !== JSON.stringify(data.settings.analysis);
+          return <div className={styles.role} key={role.id}>
+            <div><h3>{role.name}</h3><p>{role.description}</p></div>
+            <div className={styles.controls}>
+              <Select aria-label={`${role.name} model source`} value={choice.source} disabled={saving} onChange={source => choose(role.id, {source})} options={[
