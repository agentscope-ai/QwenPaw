+
+async function backendRequest<T>(path: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(`${CONFIG_BASE}${path}`, {
+    ...init,
+    headers: {
+      'Content-Type': 'application/json',
+      ...(init?.headers ?? {}),
+    },
+  });
+  const body: unknown = await response.json().catch(() => null);
+  const envelope = body as { ok?: boolean; data?: T; error?: { message?: string } } | null;
+  if (!response.ok || envelope?.ok === false) {
+    throw new Error(envelope?.error?.message || `${response.status} ${response.statusText}`);
+  }
+  if (envelope && typeof envelope === 'object' && 'ok' in envelope && 'data' in envelope) {
+    return envelope.data as T;
+  }
+  return body as T;
+}
+
+function presetForBaseUrl(baseUrl: string): string {
+  const match = LLM_PRESETS.find((preset) => preset.baseUrl && preset.baseUrl === baseUrl);
+  return match?.value ?? 'custom';
