+        {data && <p>Main chat default: <strong>{data.workspace_default.model_id || 'Not selected'}</strong>{!data.workspace_default.configured && <span className={styles.muted}> · Needs configuration in main chat</span>}</p>}
+        {data && <span className={styles.muted}>Workspace: {data.workspace_id} · New tasks use the latest settings; running tasks keep their model.</span>}
+      </div>
