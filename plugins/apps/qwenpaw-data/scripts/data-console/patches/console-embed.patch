+    setConfig((prev) => (prev ? { ...prev, [section]: { ...prev[section], ...values } } : prev));
+  };
+
+  const toggleReuse = async (target: 'llm' | 'embedding', reuse: boolean) => {
+    try {
+      setConfig(
+        await backendRequest<DataBridgeConfig>('/config/reuse-host-model', {
+          method: 'POST',
+          body: JSON.stringify({ target, reuse }),
+        }),
+      );
+    } catch (error) {
+      message.error(error instanceof Error ? error.message : String(error));
+    }
+  };
+
+  const runTest = async (target: 'llm' | 'embedding' | 'neo4j') => {
+    if (!config) return;
+    setTesting(target);
+    try {
+      const result = await backendRequest<TestResult>(`/config/test/${target}`, {
+        method: 'POST',
+        body: JSON.stringify(config),
+      });
+      if (result.ok) {
+        message.success(
+          result.detected_dim ? `${s.testOk} · dim ${result.detected_dim}` : s.testOk,
+        );
+      } else {
+        message.error(result.error || 'failed');
+      }
+    } catch (error) {
+      message.error(error instanceof Error ? error.message : String(error));
+    } finally {
+      setTesting(null);
+    }
+  };
+
+  const save = async (restart: boolean) => {
+    if (!config) return;
+    setSaving(true);
+    try {
+      setConfig(
+        await backendRequest<DataBridgeConfig>('/config', {
+          method: 'POST',
+          body: JSON.stringify(config),
+        }),
+      );
+      message.success(s.saveSuccess);
+      if (restart) {
+        await backendRequest('/config/restart-context', { method: 'POST' });
+        message.success(s.restartSuccess);
+      }
+    } catch (error) {
+      message.error(error instanceof Error ? error.message : String(error));
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <div style={{ display: 'flex', flexDirection: 'column', minHeight: 0, height: '100%' }}>
+      <ConsoleRouteHeader title={s.title} description={s.description} />
