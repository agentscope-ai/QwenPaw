+async function backendRequest<T>(path: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(`${CONFIG_BASE}${path}`, {
+    ...init,
+    headers: {
+      'Content-Type': 'application/json',
+      ...(init?.headers ?? {}),
+    },
+  });
+  const body: unknown = await response.json().catch(() => null);
+  const envelope = body as { ok?: boolean; data?: T; error?: { message?: string } } | null;
+  if (!response.ok || envelope?.ok === false) {
+    throw new Error(envelope?.error?.message || `${response.status} ${response.statusText}`);
+  }
+  if (envelope && typeof envelope === 'object' && 'ok' in envelope && 'data' in envelope) {
+    return envelope.data as T;
+  }
+  return body as T;
+}
+
+function presetForBaseUrl(baseUrl: string): string {
+  const match = LLM_PRESETS.find((preset) => preset.baseUrl && preset.baseUrl === baseUrl);
+  return match?.value ?? 'custom';
+}
+
+const fieldStyle: CSSProperties = { display: 'grid', gap: 6 };
+const labelStyle: CSSProperties = { fontSize: 13, fontWeight: 600 };
+const cardStyle: CSSProperties = {
+  display: 'grid',
+  gap: 14,
+  alignContent: 'start',
+  padding: 20,
+  borderRadius: 12,
+};
+const cardHeadStyle: CSSProperties = { display: 'grid', gap: 4 };
+
+export default function DataBridgeSettingsPage() {
+  const { language } = useAppI18n();
+  const s = STRINGS[language === 'zh' ? 'zh' : 'en'];
+
+  const [config, setConfig] = useState<DataBridgeConfig | null>(null);
+  const [loadError, setLoadError] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [saving, setSaving] = useState(false);
+  const [testing, setTesting] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    setLoading(true);
+    setLoadError('');
+    try {
+      setConfig(await backendRequest<DataBridgeConfig>('/config'));
+    } catch (error) {
+      setLoadError(error instanceof Error ? error.message : String(error));
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const patch = <K extends 'llm' | 'embedding' | 'neo4j'>(
+    section: K,
+    values: Partial<DataBridgeConfig[K]>,
+  ) => {
+    setConfig((prev) => (prev ? { ...prev, [section]: { ...prev[section], ...values } } : prev));
+  };
+
+  const toggleReuse = async (target: 'llm' | 'embedding', reuse: boolean) => {
+    try {
+      setConfig(
+        await backendRequest<DataBridgeConfig>('/config/reuse-host-model', {
+          method: 'POST',
+          body: JSON.stringify({ target, reuse }),
+        }),
+      );
+    } catch (error) {
+      message.error(error instanceof Error ? error.message : String(error));
+    }
+  };
+
+  const runTest = async (target: 'llm' | 'embedding' | 'neo4j') => {
+    if (!config) return;
+    setTesting(target);
+    try {
+      const result = await backendRequest<TestResult>(`/config/test/${target}`, {
+        method: 'POST',
+        body: JSON.stringify(config),
+      });
+      if (result.ok) {
+        message.success(
+          result.detected_dim ? `${s.testOk} · dim ${result.detected_dim}` : s.testOk,
+        );
+      } else {
+        message.error(result.error || 'failed');
+      }
+    } catch (error) {
+      message.error(error instanceof Error ? error.message : String(error));
+    } finally {
+      setTesting(null);
+    }
+  };
+
+  const save = async (restart: boolean) => {
+    if (!config) return;
+    setSaving(true);
+    try {
+      setConfig(
+        await backendRequest<DataBridgeConfig>('/config', {
+          method: 'POST',
+          body: JSON.stringify(config),
+        }),
+      );
+      message.success(s.saveSuccess);
+      if (restart) {
+        await backendRequest('/config/restart-context', { method: 'POST' });
+        message.success(s.restartSuccess);
+      }
+    } catch (error) {
+      message.error(error instanceof Error ? error.message : String(error));
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <div style={{ display: 'flex', flexDirection: 'column', minHeight: 0, height: '100%' }}>
+      <ConsoleRouteHeader title={s.title} description={s.description} />
+      <main style={{ flex: 1, overflow: 'auto', padding: '20px 24px' }}>
+        {loading ? <Spin /> : null}
+        {!loading && loadError ? (
+          <Alert
+            showIcon
+            type="error"
+            message={s.loadFailed}
+            description={loadError}
+            action={<Button size="small" onClick={() => void load()}>{s.retry}</Button>}
+          />
+        ) : null}
+        {!loading && !loadError && config ? (
+          <div style={{ display: 'grid', gap: 18, maxWidth: 1240 }}>
+            <div
+              style={{
+                display: 'grid',
+                gap: 18,
+                gridTemplateColumns: 'repeat(auto-fit, minmax(380px, 1fr))',
+              }}
+            >
+              <section className="datapaw-card-primary" style={cardStyle}>
+                <div style={cardHeadStyle}>
+                  <h2 style={{ margin: 0, fontSize: 16 }}>{s.llmTitle}</h2>
+                  <span style={{ color: 'var(--datapaw-color-text-tertiary, #86909c)', fontSize: 13 }}>
+                    {s.llmDescription}
+                  </span>
+                </div>
+                <Checkbox
+                  checked={config.llm.reuse_host}
+                  onChange={(event) => void toggleReuse('llm', event.target.checked)}
+                >
+                  {s.reuseHostLlm}
+                  {config.llm.reuse_host && config.llm.host_provider_name
+                    ? ` · ${config.llm.host_provider_name}`
+                    : ''}
+                </Checkbox>
+                {!config.llm.reuse_host ? (
+                  <>
+                    <div style={fieldStyle}>
+                      <span style={labelStyle}>{s.provider}</span>
+                      <Select
+                        value={presetForBaseUrl(config.llm.base_url)}
+                        options={LLM_PRESETS.map(({ value, label }) => ({ value, label }))}
+                        onChange={(value) => {
+                          const preset = LLM_PRESETS.find((item) => item.value === value);
+                          if (preset?.baseUrl) patch('llm', { base_url: preset.baseUrl });
+                        }}
+                      />
+                    </div>
+                    <div style={fieldStyle}>
+                      <span style={labelStyle}>{s.baseUrl}</span>
+                      <Input
+                        value={config.llm.base_url}
+                        onChange={(event) => patch('llm', { base_url: event.target.value })}
+                      />
+                    </div>
+                    <div style={fieldStyle}>
+                      <span style={labelStyle}>{s.model}</span>
+                      <Input
+                        value={config.llm.model}
+                        onChange={(event) => patch('llm', { model: event.target.value })}
+                      />
+                    </div>
+                    <div style={fieldStyle}>
+                      <span style={labelStyle}>{s.apiKey}</span>
+                      <SecretInput
+                        value={config.llm.api_key}
+                        onChange={(event) => patch('llm', { api_key: event.target.value })}
+                      />
+                    </div>
+                  </>
+                ) : null}
+                <div>
+                  <Button loading={testing === 'llm'} onClick={() => void runTest('llm')}>
+                    {s.test}
+                  </Button>
+                </div>
+              </section>
+
+              <section className="datapaw-card-primary" style={cardStyle}>
+                <div style={cardHeadStyle}>
+                  <h2 style={{ margin: 0, fontSize: 16 }}>{s.embeddingTitle}</h2>
+                  <span style={{ color: 'var(--datapaw-color-text-tertiary, #86909c)', fontSize: 13 }}>
+                    {s.embeddingDescription}
+                  </span>
+                </div>
+                <Checkbox
+                  checked={config.embedding.reuse_host}
+                  onChange={(event) => void toggleReuse('embedding', event.target.checked)}
+                >
+                  {s.reuseHostEmbedding}
+                  {config.embedding.reuse_host && config.embedding.host_provider_name
+                    ? ` · ${config.embedding.host_provider_name}`
+                    : ''}
+                </Checkbox>
+                {!config.embedding.reuse_host ? (
+                  <>
+                    <div style={fieldStyle}>
+                      <span style={labelStyle}>{s.baseUrl}</span>
+                      <Input
+                        value={config.embedding.base_url}
+                        onChange={(event) => patch('embedding', { base_url: event.target.value })}
+                      />
+                    </div>
+                    <div style={fieldStyle}>
+                      <span style={labelStyle}>{s.apiKey}</span>
+                      <SecretInput
+                        value={config.embedding.api_key}
+                        onChange={(event) => patch('embedding', { api_key: event.target.value })}
+                      />
+                    </div>
+                  </>
+                ) : null}
+                <div style={fieldStyle}>
+                  <span style={labelStyle}>{s.model}</span>
+                  <Input
+                    value={config.embedding.model}
+                    onChange={(event) => patch('embedding', { model: event.target.value })}
+                  />
+                </div>
+                <div style={fieldStyle}>
+                  <span style={labelStyle}>{s.dimensions}</span>
+                  <InputNumber
+                    min={1}
+                    style={{ width: '100%' }}
+                    value={config.embedding.dim}
+                    onChange={(value) => patch('embedding', { dim: Number(value) || 0 })}
+                  />
+                </div>
+                <div>
+                  <Button
+                    loading={testing === 'embedding'}
+                    onClick={() => void runTest('embedding')}
+                  >
+                    {s.test}
+                  </Button>
+                </div>
+              </section>
+
+              <section className="datapaw-card-primary" style={cardStyle}>
+                <div style={cardHeadStyle}>
+                  <h2 style={{ margin: 0, fontSize: 16 }}>{s.neo4jTitle}</h2>
+                  <span style={{ color: 'var(--datapaw-color-text-tertiary, #86909c)', fontSize: 13 }}>
+                    {s.neo4jDescription}
+                  </span>
+                </div>
+                <div style={fieldStyle}>
+                  <span style={labelStyle}>{s.uri}</span>
+                  <Input
+                    value={config.neo4j.uri}
+                    onChange={(event) => patch('neo4j', { uri: event.target.value })}
+                  />
+                </div>
+                <div style={fieldStyle}>
+                  <span style={labelStyle}>{s.user}</span>
+                  <Input
+                    value={config.neo4j.user}
+                    onChange={(event) => patch('neo4j', { user: event.target.value })}
+                  />
+                </div>
+                <div style={fieldStyle}>
+                  <span style={labelStyle}>{s.password}</span>
+                  <SecretInput
+                    value={config.neo4j.password}
+                    onChange={(event) => patch('neo4j', { password: event.target.value })}
+                  />
+                </div>
+                <div style={fieldStyle}>
+                  <span style={labelStyle}>{s.database}</span>
+                  <Input
+                    value={config.neo4j.database}
+                    onChange={(event) => patch('neo4j', { database: event.target.value })}
+                  />
+                </div>
+                <div>
+                  <Button loading={testing === 'neo4j'} onClick={() => void runTest('neo4j')}>
+                    {s.test}
+                  </Button>
+                </div>
+              </section>
+            </div>
+            <div style={{ display: 'flex', gap: 10 }}>
+              <Button type="primary" loading={saving} onClick={() => void save(false)}>
+                {s.save}
+              </Button>
+              <Button loading={saving} onClick={() => void save(true)}>
+                {s.saveAndRestart}
+              </Button>
+            </div>
+          </div>
+        ) : null}
+      </main>
+    </div>
+  );
+}
