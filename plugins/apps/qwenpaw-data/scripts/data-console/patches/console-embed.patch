+        message.success('Embedding settings saved; index rebuild requested.');
+      } else if (action === 'test') {
+        const result = await modelConfigApi.testEmbedding(payload);
+        if (!result.success) throw new Error(result.message);
+        message.success(result.message);
+      } else {
+        await modelConfigApi.rebuildEmbeddings(); setRebuildRequired(false); message.success('Index rebuild started.');
+      }
+    } catch(e) { setEmbeddingError((e as Error).message); }
+    finally { setEmbeddingBusy(false); }
+  };
+  return <div className={styles.root}>
