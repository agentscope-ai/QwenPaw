+import type { EmbeddingConfig } from '@/features/console/api/modelConfigTypes';
+import styles from './workspace.module.less';
+
+type Role = 'analysis' | 'lightweight' | 'databridge';
+type Choice = { source: 'inherit' | 'host' | 'local'; provider_id?: string | null; model_id?: string | null };
+type Settings = { revision: number } & Record<Role, Choice>;
+type Response = {
+  workspace_id: string; settings: Settings;
+  workspace_default: {model_id: string | null; configured: boolean; error: string | null};
+  effective: Record<Role, {model_id: string | null; source: string; configured: boolean; error: string | null}>;
+  providers: {id: string; name: string; models: {id: string; name: string}[]}[];
+};
+const endpoint = '/api/qwenpaw-data/model-settings';
+const roles: {id: Role; name: string; description: string; inherit: string}[] = [
+  {id: 'analysis', name: 'Analysis', description: 'Answers questions, reasons over data, and uses tools.', inherit: 'Use main chat model (default)'},
+  {id: 'lightweight', name: 'Summaries', description: 'Summarizes business traces and suggests follow-up questions.', inherit: 'Use analysis model'},
+  {id: 'databridge', name: 'DataBridge', description: 'Interprets semantic definitions and retrieves data context.', inherit: 'Use analysis model'},
+];
+
+export default function WorkspaceModels({onLocal}: {onLocal: () => void}) {
+  const auth = useSyncExternalStore(subscribeHostAuth, getHostAuthContext);
+  const [data, setData] = useState<Response>();
+  const [draft, setDraft] = useState<Settings>();
+  const [error, setError] = useState('');
+  const [saving, setSaving] = useState(false);
+  const [embedding, setEmbedding] = useState<EmbeddingConfig>({});
+  const [embeddingKey, setEmbeddingKey] = useState('');
+  const [embeddingError, setEmbeddingError] = useState('');
+  const [embeddingBusy, setEmbeddingBusy] = useState(false);
+  const [rebuildRequired, setRebuildRequired] = useState(false);
+  useEffect(() => {
+    if (!auth.ready) return;
+    const abort = new AbortController();
+    setData(undefined); setDraft(undefined); setError('');
+    void requestAtUrl<Response>(endpoint, {signal: abort.signal}).then(value => { setData(value); setDraft(value.settings); }).catch(e => { if (!abort.signal.aborted) setError(String(e.message)); });
+    void modelConfigApi.get(abort.signal).then(value => { setEmbedding(value.embedding); setEmbeddingError(''); }).catch(e => { if (!abort.signal.aborted) setEmbeddingError(String(e.message)); });
+    return () => abort.abort();
+  }, [auth.ready, auth.revision]);
+  const dirty = data && JSON.stringify(draft) !== JSON.stringify(data.settings);
+  const save = async () => {
+    if (!draft) return;
+    const revision = auth.revision;
+    setSaving(true); setError('');
+    try {
+      const value = await requestAtUrl<Response>(endpoint, {method: 'PUT', body: JSON.stringify(draft)});
+      if (getHostAuthContext().revision !== revision) return;
+      setData(value); setDraft(value.settings); notifyModelSettingsChanged(); message.success('Models saved. Applies to new tasks.');
+    } catch (e) { if (getHostAuthContext().revision === revision) setError((e as Error).message); }
+    finally { setSaving(false); }
+  };
+  const choose = (role: Role, choice: Choice) => setDraft(current => current ? {...current, [role]: choice} : current);
+  const embeddingAction = async (action: 'save' | 'test' | 'rebuild') => {
+    setEmbeddingBusy(true); setEmbeddingError('');
+    try {
+      const payload = {model: embedding.model, base_url: embedding.base_url, dim: embedding.dim, ...(embeddingKey ? {api_key: embeddingKey} : {})};
+      if (action === 'save') {
+        const result = await modelConfigApi.updateEmbedding(payload);
