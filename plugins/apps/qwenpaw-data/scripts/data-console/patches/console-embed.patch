@@ -0,0 +1,48 @@
+import { useEffect, useState, useSyncExternalStore } from 'react';
+import { Alert, Button, Form, InputNumber, Switch, message } from 'antd';
+import { dataConsoleApi } from '@/features/console/api/client';
+import { getHostAuthContext, subscribeHostAuth } from '@/services/auth';
+import type { RuntimeSettings } from '@/features/console/api/types';
+import { useAppI18n } from '@/i18n';
+import styles from './index.module.less';
+
+export default function AgentBehavior() {
+  const { t } = useAppI18n();
+  const auth = useSyncExternalStore(subscribeHostAuth, getHostAuthContext);
+  const [form] = Form.useForm<RuntimeSettings>();
+  const [saving, setSaving] = useState(false);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  useEffect(() => {
+    let alive = true;
+    setLoading(true);
+    setError('');
+    if (auth.ready) void dataConsoleApi.getRuntimeSettings().then(r => {
+      if (alive) form.setFieldsValue(r.runtime_settings);
+    }).catch(e => { if (alive) setError(e.message); }).finally(() => { if (alive) setLoading(false); });
+    return () => { alive = false; };
+  }, [auth.ready, auth.revision, form]);
+  const save = async (values: RuntimeSettings) => {
+    const revision = auth.revision;
+    setSaving(true); setError('');
+    try {
+      // Only send the behavior fields supported by the standalone Engine.
+      await dataConsoleApi.updateRuntimeSettings({react_max_iters: values.react_max_iters, llm_retry_enabled: values.llm_retry_enabled, llm_max_retries: values.llm_max_retries});
+      if (getHostAuthContext().revision === revision) message.success(t('agent.runtimeSettingsSaved'));
+    } catch (e) {
+      if (getHostAuthContext().revision === revision) setError((e as Error).message);
+    } finally { setSaving(false); }
+  };
+  return <div className={styles.sections}>
+    {error && <Alert type="error" message={error} />}
+    <section className={`${styles.section} datapaw-card-primary`}>
+      <div className={styles.sectionHeading}><h3>{t('agent.runtimeSettings')}</h3><p>{t('agent.runtimeSettingsDescription')}</p></div>
+      <Form form={form} layout="vertical" className={`${styles.settingsForm} ${styles.runtimeForm}`} disabled={saving || loading} onFinish={save}>
+        <Form.Item className={styles.fullWidth} label={t('agent.reactMaxIterations')} name="react_max_iters" rules={[{required:true,type:'number',min:1}]}><InputNumber min={1} precision={0} /></Form.Item>
+        <Form.Item label={t('agent.enableLlmRetry')} name="llm_retry_enabled" valuePropName="checked"><Switch /></Form.Item>
+        <Form.Item label={t('agent.maxRetries')} name="llm_max_retries" rules={[{required:true,type:'number',min:0,max:20}]}><InputNumber min={0} max={20} precision={0} /></Form.Item>
+        <div className={`${styles.formActions} ${styles.fullWidth}`}><Button type="primary" htmlType="submit" loading={saving}>{t('agent.saveRuntimeSettings')}</Button></div>
+      </Form>
+    </section>
+  </div>;
+}
diff --git a/packages/datapaw-host-core/frontend/src/pages/AgentSettings/AppLocalSettings.tsx b/packages/datapaw-host-core/frontend/src/pages/AgentSettings/AppLocalSettings.tsx
