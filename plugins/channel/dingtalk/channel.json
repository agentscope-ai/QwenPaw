{
  "schema_version": 2,
  "channel_key": "dingtalk",
  "label": {
    "en": "DingTalk",
    "zh": "钉钉"
  },
  "process_mode": "runner_process",
  "dependency_mode": "shared",
  "entrypoint": {
    "scope": "runner",
    "module": "qwenpaw_channel_dingtalk.driver",
    "qualname": "DingTalkDriver"
  },
  "requirements_file": "requirements.txt",
  "config_schema": {
    "properties": {
      "enabled": {
        "default": false,
        "title": "Enabled",
        "type": "boolean"
      },
      "bot_prefix": {
        "default": "",
        "title": "Bot Prefix",
        "type": "string"
      },
      "show_tool_calls": {
        "default": true,
        "title": "Show Tool Calls",
        "type": "boolean"
      },
      "show_tool_results": {
        "default": true,
        "title": "Show Tool Results",
        "type": "boolean"
      },
      "tool_call_max_length": {
        "default": 200,
        "minimum": 0,
        "title": "Tool Call Max Length",
        "type": "integer"
      },
      "tool_result_max_length": {
        "default": 500,
        "minimum": 0,
        "title": "Tool Result Max Length",
        "type": "integer"
      },
      "show_thinking": {
        "default": true,
        "title": "Show Thinking",
        "type": "boolean"
      },
      "dm_policy": {
        "default": "open",
        "enum": [
          "open",
          "allowlist"
        ],
        "title": "Dm Policy",
        "type": "string"
      },
      "group_policy": {
        "default": "open",
        "enum": [
          "open",
          "allowlist"
        ],
        "title": "Group Policy",
        "type": "string"
      },
      "allow_from": {
        "items": {
          "type": "string"
        },
        "title": "Allow From",
        "type": "array",
        "default": []
      },
      "deny_message": {
        "default": "",
        "title": "Deny Message",
        "type": "string"
      },
      "require_mention": {
        "default": false,
        "title": "Require Mention",
        "type": "boolean"
      },
      "no_text_debounce": {
        "default": true,
        "title": "No Text Debounce",
        "type": "boolean"
      },
      "access_control_dm": {
        "default": false,
        "title": "Access Control Dm",
        "type": "boolean"
      },
      "access_control_group": {
        "default": false,
        "title": "Access Control Group",
        "type": "boolean"
      },
      "dm_disabled": {
        "default": false,
        "title": "Dm Disabled",
        "type": "boolean"
      },
      "group_disabled": {
        "default": false,
        "title": "Group Disabled",
        "type": "boolean"
      },
      "client_id": {
        "default": "",
        "title": "Client Id",
        "type": "string"
      },
      "client_secret": {
        "default": "",
        "title": "Client Secret",
        "type": "string"
      },
      "message_type": {
        "default": "markdown",
        "title": "Message Type",
        "type": "string"
      },
      "cron_message_type": {
        "default": "markdown",
        "title": "Cron Message Type",
        "type": "string"
      },
      "card_template_id": {
        "default": "",
        "title": "Card Template Id",
        "type": "string"
      },
      "card_template_key": {
        "default": "content",
        "title": "Card Template Key",
        "type": "string"
      },
      "robot_code": {
        "default": "",
        "title": "Robot Code",
        "type": "string"
      },
      "media_dir": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Media Dir"
      },
      "card_auto_layout": {
        "default": false,
        "title": "Card Auto Layout",
        "type": "boolean"
      },
      "at_sender_on_reply": {
        "default": false,
        "title": "At Sender On Reply",
        "type": "boolean"
      },
      "streaming_enabled": {
        "default": false,
        "title": "Streaming Enabled",
        "type": "boolean"
      },
      "share_session_in_group": {
        "default": false,
        "title": "Share Session In Group",
        "type": "boolean"
      },
      "endpoint": {
        "default": "",
        "title": "Endpoint",
        "type": "string"
      }
    },
    "title": "DingTalkConfig",
    "type": "object"
  },
  "config_fields": [
    "enabled",
    "bot_prefix",
    "show_tool_calls",
    "show_tool_results",
    "tool_call_max_length",
    "tool_result_max_length",
    "show_thinking",
    "dm_policy",
    "group_policy",
    "allow_from",
    "deny_message",
    "require_mention",
    "no_text_debounce",
    "access_control_dm",
    "access_control_group",
    "dm_disabled",
    "group_disabled",
    "client_id",
    "client_secret",
    "message_type",
    "cron_message_type",
    "card_template_id",
    "card_template_key",
    "robot_code",
    "media_dir",
    "card_auto_layout",
    "at_sender_on_reply",
    "streaming_enabled",
    "share_session_in_group",
    "endpoint"
  ],
  "capabilities": [
    "approval_card",
    "channel.generic.v1",
    "channel.management.qrcode.v1",
    "media",
    "response.prepare",
    "streaming"
  ]
}
