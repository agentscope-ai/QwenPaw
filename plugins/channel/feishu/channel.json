{
  "schema_version": 2,
  "channel_key": "feishu",
  "label": {
    "en": "Feishu / Lark",
    "zh": "飞书"
  },
  "process_mode": "runner_process",
  "dependency_mode": "shared",
  "entrypoint": {
    "scope": "runner",
    "module": "qwenpaw_channel_feishu.driver",
    "qualname": "FeishuDriver"
  },
  "requirements_file": "requirements.txt",
  "config_schema": {
    "description": "Feishu/Lark channel: app_id, app_secret; optional encrypt_key,\nverification_token for event handler. media_dir for received media.\ndomain: 'feishu' for China, 'lark' for international.\nstreaming_enabled: enable CardKit streaming card updates for real-time\ntypewriter-style text output.\nauto_collapse_thinking: collapse the reasoning panel when its stream\nfinishes (the panel stays manually collapsible either way).\nshare_session_in_group: if True, all group members share one session;\nif False (default), each member gets an independent session.",
    "properties": {
      "enabled": {
        "default": false,
        "title": "Enabled",
        "type": "boolean"
      },
      "bot_prefix": {
        "default": "",
        "title": "Bot Prefix",
        "type": "string"
      },
      "show_tool_calls": {
        "default": true,
        "title": "Show Tool Calls",
        "type": "boolean"
      },
      "show_tool_results": {
        "default": true,
        "title": "Show Tool Results",
        "type": "boolean"
      },
      "tool_call_max_length": {
        "default": 200,
        "minimum": 0,
        "title": "Tool Call Max Length",
        "type": "integer"
      },
      "tool_result_max_length": {
        "default": 500,
        "minimum": 0,
        "title": "Tool Result Max Length",
        "type": "integer"
      },
      "show_thinking": {
        "default": true,
        "title": "Show Thinking",
        "type": "boolean"
      },
      "dm_policy": {
        "default": "open",
        "enum": [
          "open",
          "allowlist"
        ],
        "title": "Dm Policy",
        "type": "string"
      },
      "group_policy": {
        "default": "open",
        "enum": [
          "open",
          "allowlist"
        ],
        "title": "Group Policy",
        "type": "string"
      },
      "allow_from": {
        "items": {
          "type": "string"
        },
        "title": "Allow From",
        "type": "array",
        "default": []
      },
      "deny_message": {
        "default": "",
        "title": "Deny Message",
        "type": "string"
      },
      "require_mention": {
        "default": false,
        "title": "Require Mention",
        "type": "boolean"
      },
      "no_text_debounce": {
        "default": true,
        "title": "No Text Debounce",
        "type": "boolean"
      },
      "access_control_dm": {
        "default": false,
        "title": "Access Control Dm",
        "type": "boolean"
      },
      "access_control_group": {
        "default": false,
        "title": "Access Control Group",
        "type": "boolean"
      },
      "dm_disabled": {
        "default": false,
        "title": "Dm Disabled",
        "type": "boolean"
      },
      "group_disabled": {
        "default": false,
        "title": "Group Disabled",
        "type": "boolean"
      },
      "app_id": {
        "default": "",
        "title": "App Id",
        "type": "string"
      },
      "app_secret": {
        "default": "",
        "title": "App Secret",
        "type": "string"
      },
      "encrypt_key": {
        "default": "",
        "title": "Encrypt Key",
        "type": "string"
      },
      "verification_token": {
        "default": "",
        "title": "Verification Token",
        "type": "string"
      },
      "media_dir": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Media Dir"
      },
      "domain": {
        "default": "feishu",
        "title": "Domain",
        "type": "string",
        "pattern": "^(feishu$|lark$|https?://)"
      },
      "streaming_enabled": {
        "default": false,
        "title": "Streaming Enabled",
        "type": "boolean"
      },
      "share_session_in_group": {
        "default": false,
        "title": "Share Session In Group",
        "type": "boolean"
      },
      "auto_collapse_thinking": {
        "default": false,
        "title": "Auto Collapse Thinking",
        "type": "boolean"
      }
    },
    "title": "FeishuConfig",
    "type": "object"
  },
  "config_fields": [
    "enabled",
    "bot_prefix",
    "show_tool_calls",
    "show_tool_results",
    "tool_call_max_length",
    "tool_result_max_length",
    "show_thinking",
    "dm_policy",
    "group_policy",
    "allow_from",
    "deny_message",
    "require_mention",
    "no_text_debounce",
    "access_control_dm",
    "access_control_group",
    "dm_disabled",
    "group_disabled",
    "app_id",
    "app_secret",
    "encrypt_key",
    "verification_token",
    "media_dir",
    "domain",
    "streaming_enabled",
    "share_session_in_group",
    "auto_collapse_thinking"
  ],
  "capabilities": [
    "approval_card",
    "channel.generic.v1",
    "channel.management.qrcode.v1",
    "media",
    "reaction",
    "streaming"
  ]
}
