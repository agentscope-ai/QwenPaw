{
  "schema_version": 2,
  "channel_key": "mattermost",
  "label": {
    "en": "Mattermost",
    "zh": "Mattermost"
  },
  "process_mode": "runner_process",
  "dependency_mode": "shared",
  "entrypoint": {
    "scope": "runner",
    "module": "qwenpaw_channel_mattermost.driver",
    "qualname": "MattermostDriver"
  },
  "requirements_file": "requirements.txt",
  "config_schema": {
    "description": "Mattermost channel: WebSocket polling and REST API.",
    "properties": {
      "enabled": {
        "default": false,
        "title": "Enabled",
        "type": "boolean"
      },
      "bot_prefix": {
        "default": "",
        "title": "Bot Prefix",
        "type": "string"
      },
      "show_tool_calls": {
        "default": true,
        "title": "Show Tool Calls",
        "type": "boolean"
      },
      "show_tool_results": {
        "default": true,
        "title": "Show Tool Results",
        "type": "boolean"
      },
      "tool_call_max_length": {
        "default": 200,
        "minimum": 0,
        "title": "Tool Call Max Length",
        "type": "integer"
      },
      "tool_result_max_length": {
        "default": 500,
        "minimum": 0,
        "title": "Tool Result Max Length",
        "type": "integer"
      },
      "show_thinking": {
        "default": true,
        "title": "Show Thinking",
        "type": "boolean"
      },
      "dm_policy": {
        "default": "open",
        "enum": [
          "open",
          "allowlist"
        ],
        "title": "Dm Policy",
        "type": "string"
      },
      "group_policy": {
        "default": "open",
        "enum": [
          "open",
          "allowlist"
        ],
        "title": "Group Policy",
        "type": "string"
      },
      "allow_from": {
        "items": {
          "type": "string"
        },
        "title": "Allow From",
        "type": "array",
        "default": []
      },
      "deny_message": {
        "default": "",
        "title": "Deny Message",
        "type": "string"
      },
      "require_mention": {
        "default": false,
        "title": "Require Mention",
        "type": "boolean"
      },
      "no_text_debounce": {
        "default": true,
        "title": "No Text Debounce",
        "type": "boolean"
      },
      "access_control_dm": {
        "default": false,
        "title": "Access Control Dm",
        "type": "boolean"
      },
      "access_control_group": {
        "default": false,
        "title": "Access Control Group",
        "type": "boolean"
      },
      "dm_disabled": {
        "default": false,
        "title": "Dm Disabled",
        "type": "boolean"
      },
      "group_disabled": {
        "default": false,
        "title": "Group Disabled",
        "type": "boolean"
      },
      "url": {
        "default": "",
        "title": "Url",
        "type": "string"
      },
      "bot_token": {
        "default": "",
        "title": "Bot Token",
        "type": "string"
      },
      "media_dir": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Media Dir"
      },
      "show_typing": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Show Typing"
      },
      "thread_follow_without_mention": {
        "default": false,
        "title": "Thread Follow Without Mention",
        "type": "boolean"
      }
    },
    "title": "MattermostConfig",
    "type": "object"
  },
  "config_fields": [
    "enabled",
    "bot_prefix",
    "show_tool_calls",
    "show_tool_results",
    "tool_call_max_length",
    "tool_result_max_length",
    "show_thinking",
    "dm_policy",
    "group_policy",
    "allow_from",
    "deny_message",
    "require_mention",
    "no_text_debounce",
    "access_control_dm",
    "access_control_group",
    "dm_disabled",
    "group_disabled",
    "url",
    "bot_token",
    "media_dir",
    "show_typing",
    "thread_follow_without_mention"
  ],
  "capabilities": [
    "channel.generic.v1",
    "media",
    "response.prepare"
  ]
}
