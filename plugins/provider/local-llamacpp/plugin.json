{
  "id": "local-llamacpp",
  "name": "QwenPaw Local",
  "version": "1.1.0",
  "description": "Install and download local models; manage the llama.cpp server.",
  "type": "provider",
  "entry": {
    "backend": "plugin.py"
  },
  "sdk": {
    "version": "1.2.0",
    "capabilities": [
      "providers",
      "resources",
      "apps",
      "config",
      "logging",
      "storage",
      "cli",
      "extensions"
    ]
  },
  "author": "QwenPaw",
  "license": "Apache-2.0",
  "cli": [
    {
      "id": "download",
      "path": [
        "models",
        "download"
      ],
      "help": "Download a local model repository."
    },
    {
      "id": "local",
      "path": [
        "models",
        "local"
      ],
      "help": "List all downloaded local models."
    },
    {
      "id": "remove-local",
      "path": [
        "models",
        "remove-local"
      ],
      "help": "Remove a downloaded local model."
    }
  ],
  "extensions": [
    {
      "point": "qwenpaw.doctor",
      "id": "local-model"
    },
    {
      "point": "qwenpaw.doctor",
      "id": "local-server"
    }
  ]
}
