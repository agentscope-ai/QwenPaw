# QwenPaw local promptfoo target
QWENPAW_BASE_URL=http://127.0.0.1:8088
QWENPAW_AGENT_ID=default
QWENPAW_AUTH_TOKEN=
QWENPAW_TIMEOUT_MS=180000

# Promptfoo redteam generation/grading provider.
# Any OpenAI-compatible endpoint can be used here.
PROMPTFOO_OPENAI_BASE_URL=https://api.deepseek.com/v1
PROMPTFOO_OPENAI_API_KEY=
PROMPTFOO_OPENAI_MODEL=deepseek-chat
PROMPTFOO_OPENAI_MAX_TOKENS=32000
PROMPTFOO_OPENAI_TIMEOUT_MS=180000
PROMPTFOO_OPENAI_TEMPERATURE=0.3

PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=true
