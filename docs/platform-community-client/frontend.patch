diff --git a/src/lib/cliOAuthParams.ts b/src/lib/cliOAuthParams.ts
index 9102078..ba62784 100644
--- a/src/lib/cliOAuthParams.ts
+++ b/src/lib/cliOAuthParams.ts
@@ -64,3 +64,9 @@ export function buildCliLoginPath(searchParams: URLSearchParams): string {
   const query = searchParams.toString();
   return query ? `/cli/login?${query}` : "/cli/login";
 }
+
+/** Presentation hint only; OAuth identity and permissions stay unchanged. */
+export function isQwenPawCommunityLogin(searchParams: URLSearchParams): boolean {
+  return searchParams.get("client_id")?.trim() === CLI_CLIENT_ID
+    && searchParams.get("source") === "qwenpaw-community";
+}
