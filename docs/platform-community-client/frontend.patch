diff --git a/tests/oauth-clients.test.mjs b/tests/oauth-clients.test.mjs
new file mode 100644
index 0000000..27d9a55
--- /dev/null
+++ b/tests/oauth-clients.test.mjs
@@ -0,0 +1,59 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+import { build } from 'vite';
+
+const result = await build({
+  configFile: false,
+  logLevel: 'silent',
+  resolve: { alias: { '@': fileURLToPath(new URL('../src', import.meta.url)) } },
+  build: {
+    write: false,
+    minify: false,
+    lib: {
+      entry: fileURLToPath(new URL('../src/lib/cliOAuthParams.ts', import.meta.url)),
+      formats: ['es'],
+    },
+  },
+});
+const output = (Array.isArray(result) ? result[0] : result).output;
+const code = output.find(item => item.type === 'chunk').code;
+const { validateCliOAuthParams, parseCliOAuthParams, buildCliLoginPath, isQwenPawCommunityLogin } =
+  await import(`data:text/javascript;base64,${Buffer.from(code).toString('base64')}`);
+const params = {
+  client_id: 'agentscope-platform-cli',
+  scope: 'platform:control',
+  redirect_uri: 'http://127.0.0.1:18892/callback/test_nonce',
+  response_type: 'code',
+  state: 'state-1',
+  code_challenge: 'a'.repeat(43),
+  code_challenge_method: 'S256',
+};
+for (const source of ['', 'qwenpaw-community']) {
+  test(`${source || 'CLI'} preserves login context without changing OAuth identity`, () => {
+    const input = new URLSearchParams({ ...params, source });
+    const parsed = parseCliOAuthParams(input);
+    assert.equal(validateCliOAuthParams(parsed), null);
+    assert.equal(parsed.client_id, 'agentscope-platform-cli');
+    assert.equal(Object.hasOwn(parsed, 'source'), false);
+    assert.equal(isQwenPawCommunityLogin(input), source === 'qwenpaw-community');
+    const returnUrl = new URL(buildCliLoginPath(input), 'https://platform.agentscope.io');
+    assert.equal(returnUrl.searchParams.get('source'), source);
+    assert.equal(returnUrl.searchParams.get('redirect_uri'), params.redirect_uri);
+    assert.equal(returnUrl.searchParams.get('state'), params.state);
+  });
+}
+test('source hint cannot admit an unsupported client', () => {
+  const input = new URLSearchParams({...params, client_id: 'qwenpaw-community', source: 'qwenpaw-community'});
+  assert.equal(isQwenPawCommunityLogin(input), false);
+  assert.equal(validateCliOAuthParams(parseCliOAuthParams(input)), 'invalid_client');
+});
+for (const [changes, error] of [
+  [{client_id: 'unknown'}, 'invalid_client'],
+  [{redirect_uri: 'https://example.com/callback/test_nonce'}, 'invalid_redirect_uri'],
+  [{code_challenge_method: 'plain'}, 'invalid_challenge_method'],
+]) {
+  test(`rejects ${error}`, () => {
+    assert.equal(validateCliOAuthParams({...params, ...changes}), error);
+  });
+}
