+#include "../tools/server/server-decision.h"
+#include <fstream>
+#include <iostream>
+
+// Export actual runtime token rows for comparison with the checkpoint tokenizer.
+int main(int argc, char ** argv) {
+    if (argc != 3) { return 2; }
+    llama_model_params params = llama_model_default_params();
+    params.vocab_only = true;
+    llama_model * model = llama_model_load_from_file(argv[1], params);
+    if (!model) { return 3; }
+    try {
+        server_decision_context ctx;
+        ctx.init(model);
+        json body;
+        std::ifstream input(argv[2]);
+        body = json::parse(std::string(std::istreambuf_iterator<char>(input), {}));
+        auto questions = ctx.parse_questions(body);
+        json out = json::array();
+        for (const auto & question : questions) {
+            server_task task;
+            ctx.fill_task(body.at("state"), questions, question, 0, {}, nullptr, {}, task);
+            out.push_back({{"question_id", question.id}, {"input_ids", task.tokens.get_text_tokens()},
+                           {"candidate_ids", task.decision.labels}});
+        }
+        std::cout << out.dump() << std::endl;
+    } catch (const std::exception & e) {
+        std::cerr << e.what() << std::endl;
+        llama_model_free(model);
+        return 1;
+    }
+    llama_model_free(model);
+}
