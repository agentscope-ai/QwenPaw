+// FlexDM v1.0 state annotations and token boundaries (MIT, Copyright 2026 1000luca).
+static json decision_piccolo_indices(const json & val, int depth = 0) {
+    if (depth >= RECURSIVE_LIMIT) {
+        throw std::invalid_argument("Piccolo state is nested too deeply");
+    }
+    if (val.is_array()) {
+        json out = json::array();
+        for (size_t i = 0; i < val.size(); i++) {
+            json item = decision_piccolo_indices(val.at(i), depth + 1);
+            if (val.size() >= 8) {
+                json indexed = json{{"_index", i}};
+                if (item.is_object()) {
+                    for (const auto & [key, value] : item.items()) {
+                        indexed[key] = value;
+                    }
+                } else {
+                    indexed["value"] = item;
+                }
+                item = std::move(indexed);
+            }
+            out.push_back(item);
+        }
+        return out;
+    }
+    if (val.is_object()) {
+        json out = json::object();
+        for (const auto & [key, item] : val.items()) {
+            out[key] = decision_piccolo_indices(item, depth + 1);
+        }
+        return out;
+    }
+    return val;
+}
+
+static std::string decision_piccolo_text(const json & val) {
+    return val.is_string() ? val.get<std::string>() : decision_py_dumps(val, -1, ", ", ": ", false);
+}
+
+void server_decision_context::fill_task_piccolo(
+        const json & state,
+        const std::vector<server_decision_question> & questions,
+        const server_decision_question & question,
+        server_task & task) const {
+    const auto encode = [this](const std::string & text) { return common_tokenize(vocab, text, false, true); };
+    const auto append = [](llama_tokens & dest, const llama_tokens & part) { dest.insert(dest.end(), part.begin(), part.end()); };
+    const auto text = [](const server_decision_question & q) {
+        if (q.type == SERVER_DECISION_QUESTION_NOUL && (q.instructions.is_null() || q.instructions == "")) {
+            return std::string("Which answer fits the context?");
+        }
+        return decision_piccolo_text(q.instructions);
+    };
+    std::string listing = "Questions that will be asked about the context:\n";
+    for (const auto & q : questions) {
+        listing += "- " + text(q) + "\n";
+    }
+    listing += "\n";
+    const std::string state_text = decision_piccolo_text(decision_piccolo_indices(state));
+    llama_tokens ctx = piccolo_head;
+    append(ctx, encode(listing));
+    append(ctx, encode("Context:\n" + state_text));
+    const llama_tokens again = encode("\n\nRead the same input again before answering:\n" + listing + "Context:\n" + state_text);
+    llama_tokens suffix = piccolo_tail;
+    append(suffix, encode("Answer: ("));
+    std::vector<llama_tokens> pieces;
+    size_t once_tokens = ctx.size();
+    bool repeat = true;
+    size_t selected = 0;
+    for (const auto & q : questions) {
+        llama_tokens part = encode("\n\nQuestion: " + text(q) + "\nOptions:");
+        std::string short_options;
+        for (size_t i = 0; i < q.options.size(); i++) {
+            const auto & opt = q.options[i];
+            std::string option = q.type == SERVER_DECISION_QUESTION_NOUL ? (opt.key == "true" ? "yes" : "no") : opt.key;
+            if (!opt.description.is_null() && opt.description != "") {
+                option += ": " + decision_piccolo_text(opt.description);
+            }
+            if (q.options.size() <= 10) {
+                short_options += "\n(" + label_texts[i] + ") " + option;
+            } else {
+                append(part, encode("\n("));
+                part.push_back(labels[i]);
+                append(part, encode(") " + option));
+            }
+        }
+        if (q.options.size() <= 10) {
+            append(part, encode(short_options));
+        }
+        once_tokens += part.size() + suffix.size();
+        repeat = repeat && ctx.size() + 2 * part.size() + again.size() + suffix.size() < piccolo_max_context;
+        if (q.id == question.id) {
+            selected = pieces.size();
+        }
+        pieces.push_back(std::move(part));
+    }
+    repeat = repeat && once_tokens <= 3000;
+    const auto & part = pieces.at(selected);
+    append(ctx, part);
+    if (repeat) {
+        append(ctx, again);
+        append(ctx, part);
+    }
+    append(ctx, suffix);
+    if (ctx.size() >= piccolo_max_context) {
+        throw std::invalid_argument("Complete Piccolo prompt exceeds context; truncation is not allowed");
+    }
+    task.tokens = server_tokens(ctx, false);
+    task.decision.labels.assign(labels.begin(), labels.begin() + question.options.size());
+    task.decision.no_batching = true;
+    task.params.cache_prompt = false;
+}
