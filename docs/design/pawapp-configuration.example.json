{
  "$comment": "PROPOSAL ONLY. Illustrative configuration fragments, not an installable plugin manifest or an implemented SDK schema. All IDs and runtime mappings require a real adapter; no credentials are embedded.",
  "schema_version": "pawapp-configuration/proposal-4",
  "host_contract": {
    "ui_ownership": "app-settings-retained; host-forms-optional",
    "authority_modes": [
      "HostBinding",
      "AppLocal",
      "ExternalManaged"
    ],
    "authority_rule": "one-explicit-authority-per-configuration-item; host-manages-HostBinding-only; no-silent-migration-or-bidirectional-sync",
    "host_settings_sections": [
      "models-and-providers",
      "services-and-connections",
      "resource-usage-and-grants"
    ],
    "app_settings_sections": [
      "app-model-purpose-bindings",
      "app-deployment-and-runtime",
      "app-domain-settings"
    ],
    "ui_placement": {
      "host_shell_embedding_does_not_transfer_ui_ownership": true,
      "binding_storage_does_not_determine_ui_location": true,
      "main_chat": "readiness-summary; inline-choice-or-consent; contextual-secure-modal; app-setup-handoff",
      "shared_picker": "optional-component-inside-app-owned-form; create-or-select-in-place; no-required-host-settings-detour",
      "app_setup": "registered-app-entry-with-purpose-focus; preserve-existing-project-draft-and-origin; reprepare-on-result",
      "setup_handoff_changes_task_interaction_owner": false,
      "review_controls_are_product_navigation": false
    },
    "binding_precedence": [
      "project-explicit",
      "app-default",
      "workspace-approved-default"
    ],
    "invalid_explicit_binding": "block-without-silent-fallback",
    "deployment_locked_fields": "reject-overrides",
    "frontend_delivery": "public-settings-and-binding-status-only",
    "backend_delivery": "scoped-model-or-service-handle",
    "provider_sdk_exception": "explicitly-approved-backend-lease-or-injection",
    "model_snapshot": "pin-binding-revision-at-job-start",
    "secret_storage": "host-secret-store-for-HostBinding; app-or-external-owner-otherwise",
    "configuration_is_execution_authorization": false,
    "generic_layers": [
      "SetupRequirement-and-SetupRequest-lifecycle",
      "optional-typed-model-connection-permission-domain-adapters",
      "app-owned-settings-and-checkers"
    ],
    "configuration_required_for_core": false,
    "typed_declarations": "models/connections/domain_requirements are optional authoring forms; adapters normalize them to SetupRequirement with resolved authority and registered check_ref; reject duplicate requirement IDs"
  },
  "online_preparation": {
    "$comment": "Proposed runtime contract. The mock evaluates changing in-memory facts; it does not probe real services or implement server-side enforcement.",
    "trigger": [
      "next-confirmed-plan-phase",
      "setup-return",
      "configuration-or-grant-change",
      "reconnect",
      "before-execution"
    ],
    "main_chat": "suggest-action-and-nonsecret-values-with-provenance; never-read-raw-credentials",
    "host": "coordinate-registered-checkers; validate-host-owned-state-and-grants; never-override-host-denial-with-app-ready",
    "app": "declare-conditional-needs; report-public-readiness; own-domain-setup; execution-effects-are-separate-actions",
    "prepare_is_read_only": true,
    "auto_binding_commit": "separate-host-step-under-existing-grant; the mock prepare button illustrates this whole sequence",
    "auto_bind_requires": [
      "explicit-authority-allows-reuse",
      "unique-or-explicitly-preferred-compatible-candidate",
      "existing-valid-use-grant",
      "allowed-scope-data-boundary-and-budget-policy",
      "fresh-state",
      "no-invalid-explicit-binding"
    ],
    "interaction_kinds": [
      "none",
      "inline-choice-or-consent",
      "app-owned-setup-with-optional-host-secure-component",
      "retry-or-block"
    ],
    "freshness": {
      "checked_at": "required",
      "expires_at": "required",
      "bounded_probe_deadline": true,
      "invalidate_on_revision_change": true,
      "timeout_result": "unknown-not-missing",
      "recheck_before_commit_and_execute": true
    },
    "challenge_bound_fields": [
      "challenge_id",
      "principal",
      "app_id",
      "workspace_id",
      "task_id-if-present",
      "project_id-if-present",
      "plan_digest-if-present",
      "context_revision-if-present",
      "relevant-owner-config-revisions",
      "policy_revision",
      "listed_resource_scopes",
      "expires_at",
      "registered_return_target"
    ],
    "commit": "validate-challenge-and-schema; compare-and-swap; record-scoped-change; return-public-refs-only",
    "continuation": {
      "reprepare_after_setup": true,
      "requires_existing_execution_grant": true,
      "idempotency_key": "task_id+continuation_id",
      "cancel_preserves_draft": true,
      "unknown_external_job": "reconcile-before-retry"
    }
  },
