  "setup_contract": {
    "$comment": "Proposed generic protocol. Entry/check references resolve to App-registered handlers. Optional typed declarations normalize to SetupRequirement; no model or connection is required for an App.",
    "optional_for_core": true,
    "declared_entry_requires_handler": true,
    "declaration_fields": [
      "id",
      "entry_ref",
      "focus",
      "presentations",
      "context_schema_version",
      "optional-when",
      "optional-fallback"
    ],
    "registry_validation": [
      "app-scoped-entry-id",
      "manifest-handler-descriptor-digest-match",
      "focus-and-presentation-supported",
      "bounded-activation-and-ready-ack",
      "unregister-on-dispose"
    ],
    "request_fields": [
      "request_id",
      "app_id",
      "descriptor_digest",
      "entry_id",
      "requirement_ids",
      "origin_ref",
      "task_id-if-present",
      "action_id-if-present",
      "project_ref-if-present",
      "plan_digest-if-present",
      "expected_revisions",
      "scopes",
      "suggested_values-with-provenance",
      "presentation",
      "expires_at",
      "return_target"
    ],
    "identity": "principal-and-workspace-derived-by-host; request-id-is-not-authorization",
    "navigation": "reuse-mounted-app-and-project; app-handles-internal-route-and-modal; URL-may-contain-opaque-request-id-only",
    "lifecycle": [
      "requested",
      "opened",
      "waiting_external-if-needed",
      "saved|cancelled|failed|expired"
    ],
    "result_fields": [
      "request_id",
      "result_id",
      "outcome",
      "changed_requirement_ids",
      "config_revisions",
      "public_refs",
      "pending_effects",
      "error_code"
    ],
    "error_codes": [
      "unsupported_setup",
      "entry_unavailable",
      "presentation_unsupported",
      "context_conflict",
      "request_expired",
      "validation_failed",
      "permission_denied",
      "external_timeout"
    ],
    "completion": "app-backend-authenticated-receipt; host-validates-request-and-versions; saved-is-not-ready",
    "replay": "deduplicate-request-and-result; duplicate-open-focuses-existing-draft; duplicate-result-never-restarts-work",
    "manual_open": "task/action/plan/context are absent unless applicable; check relevant configuration/policy revisions; recheck selected requirements; return to App without task creation or continuation",
    "fallback": "registered-app-entry-or-explicit-error; preserve-draft; never-guess-URL-or-claim-ready",
    "shared_resource_ui": "one-app-owned-form-may-create-connection-and-request-scoped-use-consent; operations-remain-separately-audited",
    "partial_save": "retain-draft-and-created-resource-ref; reconcile-before-retry; no-duplicate-resource-or-auto-execution",
