{
  "version": 1,
  "name": "integrity-delivery-selftest",
  "description": "Unified self-test net for all Integrity Protection deliveries (rule integrity, file baseline, health check).",
  "console_gate": {
    "typecheck": {
      "label": "Console tsc + vite build",
      "cwd": "console",
      "command": "npm run build"
    }
  },
  "deliveries": [
    {
      "id": "rule-integrity",
      "label": "Built-in tool rule integrity",
      "manifest": "extension/rule-integrity-selftest.manifest.json"
    },
    {
      "id": "file-baseline",
      "label": "File Baseline Protection",
      "manifest": "scripts/file-baseline-selftest.manifest.json"
    },
    {
      "id": "health-check",
      "label": "Integrity Protection Health Check",
      "manifest": "scripts/health-check-selftest.manifest.json"
    },
    {
      "id": "skill-sign",
      "label": "Skill pool secure import (Ed25519)",
      "manifest": "extension/skill-sign-selftest.manifest.json"
    }
  ]
}
