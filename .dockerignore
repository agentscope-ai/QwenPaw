# Git and IDE
.git
.gitignore
.idea
.vscode
*.md
!README.md

# Python dev and cache
# Bare patterns only match the context root, so the ** forms are what keep
# nested caches (e.g. plugins/bundle/*/__pycache__) out of the image.
__pycache__
**/__pycache__
*.py[cod]
**/*.py[cod]
*$py.class
.venv
venv
uv.lock
.pytest_cache
.coverage
htmlcov
.tox
.mypy_cache
.ruff_cache

# Tests (not needed in runtime image)
tests
test.py
*_test.py
pytest.ini
.pre-commit-config.yaml
.flake8
.eslintrc
.stylelintrc

# Frontend: exclude build artifacts; ship pre-built src/console/dist in image
website
!website/
!website/public/
!website/public/docs/
!website/public/docs/**
console/node_modules
console/dist
console/.vite
node_modules
**/node_modules
**/dist
!src/qwenpaw/console/dist
!src/qwenpaw/console/dist/**
# Bundled plugins ship their console UI as a committed dist bundle; without
# this the image gets the plugin minus its settings page.
!plugins/bundle/*/frontend/dist
!plugins/bundle/*/frontend/dist/**
**/.vite

# Example and local config (mount at runtime instead)
example
config.json
jobs.json
sessions_mount_dir

# Misc
.env
.env.*
!.env.example
.DS_Store
*.log
logs
cookbook
