{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "date": {
      "type": "string",
      "format": "timestamp"
    },
    "kind": {
      "enum": ["testing", "official"]
    },
    "sdk_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_repository": {
      "type": "string",
      "format": "public-https-url"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exchange_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cny_per_usd", "basis"],
      "properties": {
        "cny_per_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "basis": {
          "const": "fixed"
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group_by"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "group_by": {
          "enum": ["model", "model_harness"]
        }
      }
    },
    "schema_version": {
      "const": 3
    },
    "experiment": {
      "type": "string",
      "minLength": 1
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "harness": {
      "type": "string",
      "minLength": 1
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          }
        },
        "expected": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["programmatic", "llm"]
            },
            "model": {
              "type": ["string", "null"]
            },
            "scorer": {
              "type": ["string", "null"]
            },
            "official_model": {
              "type": ["string", "null"]
            },
            "prompt_revision": {
              "type": ["string", "null"]
            },
            "parity_note": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "model",
            "scorer",
            "official_model",
            "prompt_revision",
            "parity_note"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "llm"
                  }
                }
              },
              "then": {
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scorer": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "scorer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision",
        "domains",
        "expected",
        "name",
        "judge",
        "instances",
        "repetitions"
      ]
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instance": {
            "type": "string",
            "minLength": 1
          },
          "repeat": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "passed",
              "timeout",
              "execution_error",
              "infrastructure_error",
              "scoring_error",
              "artifact_error"
            ]
          },
          "score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "failure_reason": {
            "type": ["string", "null"]
          },
          "cost": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["amount", "currency"],
                "properties": {
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "currency": {
                    "enum": ["CNY", "USD"]
                  }
                }
              }
            ]
          },
          "judge_cost": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["amount", "currency"],
                "properties": {
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "currency": {
                    "enum": ["CNY", "USD"]
                  }
                }
              }
            ]
          },
          "judge_called": {
            "type": "boolean"
          },
          "runtime_seconds": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "finished_at": {
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "properties": {
                "score": {
                  "type": "number"
                },
                "failure_reason": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "score": {
                  "type": "null"
                },
                "failure_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ],
        "required": [
          "instance",
          "repeat",
          "status",
          "score",
          "failure_reason",
          "cost",
          "judge_cost",
          "judge_called",
          "runtime_seconds",
          "finished_at"
        ]
      }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_context_length": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "max_response_length": {
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "required": ["max_context_length", "max_response_length"]
    }
  },
  "required": [
    "id",
    "date",
    "kind",
    "sdk_version",
    "source_sha",
    "source_repository",
    "artifact_sha256",
    "exchange_rate",
    "board",
    "schema_version",
    "experiment",
    "candidate_hash",
    "profile_hash",
    "protocol_hash",
    "provider",
    "model",
    "harness",
    "benchmark",
    "trials",
    "sources",
    "parameters"
  ]
}
