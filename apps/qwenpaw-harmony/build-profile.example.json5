{
  app: {
    signingConfigs: [
      {
        name: 'default',
        type: 'HarmonyOS',
        material: {
          certpath: '<本机 .cer 路径>',
          keyAlias: '<密钥别名>',
          keyPassword: '<密钥口令>',
          profile: '<本机 .p7b 路径>',
          signAlg: 'SHA256withECDSA',
          storeFile: '<本机 .p12 路径，如 /home/<user>/.ohos/config/default_xxx.p12>',
          storePassword: '<密钥库口令>',
        },
      },
    ],
    products: [
      {
        name: 'default',
        signingConfig: 'default',
        targetSdkVersion: '26.0.0',
        compatibleSdkVersion: '26.0.0',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}