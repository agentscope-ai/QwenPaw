POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# 密码含特殊字符时，在 URL 中进行百分号编码；db 是 Compose 数据库服务名。
QWENPAW_DATABASE_URL=postgresql://qwenpaw:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/qwenpaw
# 完成全新初始化检查或旧数据迁移验收后，才能显式填入 all。
QWENPAW_CUTOVER_VALIDATED_DOMAINS=
QWENPAW_CUTOVER_LEGACY_FROZEN_DOMAINS=
QWENPAW_CUTOVER_POSTGRES_WRITES_DOMAINS=
